generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
  cancelled

  @@map("ticket_status")
}

enum TicketPriority {
  low
  medium
  high
  urgent

  @@map("ticket_priority")
}

model Corporation {
  id         Int     @id @default(autoincrement()) @map("id")
  name       String  @map("name")
  isActive   Boolean @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  users      User[]  @relation("corporation_users")

  @@map("corporations")
}

model Role {
  id         Int     @id @default(autoincrement()) @map("id")
  name       String  @unique @map("name")
  description String? @map("description")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  users      User[]  @relation("role_users")

  @@map("roles")
}

model User {
  id            Int       @id @default(autoincrement()) @map("id")
  ci            String    @unique @map("ci")
  phone         String?   @map("phone")
  cell          String?   @map("cell")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String    @unique @map("email")
  password      String    @map("password")
  isActive      Boolean   @default(true) @map("is_active")
  corporationId Int?      @map("corporation_id")
  roleId        Int       @map("role_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  corporation   Corporation? @relation("corporation_users", fields: [corporationId], references: [id])
  role          Role         @relation("role_users", fields: [roleId], references: [id])

  ticketsCreated  Ticket[]       @relation("ticket_createdBy")
  ticketsAssigned Ticket[]       @relation("ticket_assignedTo")
  ticketsEmitted   Ticket[]      @relation("ticket_emitter")
  historyChanges   TicketHistory[] @relation("history_changedBy")

  userGroups       UserGroup[]
  userPermissions  UserPermission[]

  @@map("users")
  @@index([corporationId], map: "idx_users_corporation_id")
  @@index([roleId], map: "idx_users_role_id")
}

model Service {
  id         Int      @id @default(autoincrement()) @map("id")
  name       String   @unique @map("name")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  tickets    Ticket[] 

  @@map("services")
}

model Ticket {
  id             Int            @id @default(autoincrement()) @map("id")
  title          String         @map("title")
  description    String         @map("description")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  resolvedAt     DateTime?      @map("resolved_at")
  status         TicketStatus   @default(open) @map("status")
  priority       TicketPriority @default(medium) @map("priority")
  createdById    Int            @map("created_by_id")
  assignedToId   Int?           @map("assigned_to_id")
  emitterId      Int?           @map("emitter_id")
  serviceId      Int?           @map("service_id")
  slaMinutes     Int?           @map("sla_minutes")
  deletedAt      DateTime?      @map("deleted_at")

  createdBy      User           @relation("ticket_createdBy", fields: [createdById], references: [id])
  assignedTo     User?          @relation("ticket_assignedTo", fields: [assignedToId], references: [id])
  emitter        User?          @relation("ticket_emitter", fields: [emitterId], references: [id])
  service        Service?       @relation(fields: [serviceId], references: [id])
  history        TicketHistory[] @relation("ticket_history")

  @@map("tickets")
  @@index([status], map: "idx_tickets_status")
  @@index([priority], map: "idx_tickets_priority")
  @@index([assignedToId], map: "idx_tickets_assigned_to")
  @@index([serviceId], map: "idx_tickets_service_id")
}

model TicketHistory {
  id             Int          @id @default(autoincrement()) @map("id")
  ticketId       Int          @map("ticket_id")
  changedById    Int?         @map("changed_by_id")
  previousStatus TicketStatus? @map("previous_status")
  newStatus      TicketStatus @map("new_status")
  comment        String?      @map("comment")
  changedAt      DateTime     @default(now()) @map("changed_at")

  ticket         Ticket       @relation("ticket_history", fields: [ticketId], references: [id])
  changedBy      User?        @relation("history_changedBy", fields: [changedById], references: [id])

  @@map("ticket_histories")
  @@index([ticketId], map: "idx_ticket_histories_ticket_id")
}

/*
  Permisos y grupos (modelo simple)
*/
model Permission {
  id          Int      @id @default(autoincrement()) @map("id")
  name        String   @map("name")
  codename    String   @unique @map("codename")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  groupPermissions GroupPermission[]
  userPermissions  UserPermission[]

  @@map("permissions")
}

model Group {
  id              Int               @id @default(autoincrement()) @map("id")
  name            String            @unique @map("name")
  description     String?           @map("description")
  createdAt       DateTime          @default(now()) @map("created_at")

  groupPermissions GroupPermission[]
  userGroups       UserGroup[]

  @@map("groups")
}

model GroupPermission {
  id           Int        @id @default(autoincrement()) @map("id")
  groupId      Int        @map("group_id")
  permissionId Int        @map("permission_id")

  group        Group      @relation(fields: [groupId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@map("group_permissions")
  @@index([groupId], map: "idx_group_permissions_group_id")
  @@index([permissionId], map: "idx_group_permissions_permission_id")
}

model UserGroup {
  id      Int   @id @default(autoincrement()) @map("id")
  userId  Int   @map("user_id")
  groupId Int   @map("group_id")

  user    User  @relation(fields: [userId], references: [id])
  group   Group @relation(fields: [groupId], references: [id])

  @@map("user_groups")
  @@index([userId], map: "idx_user_groups_user_id")
  @@index([groupId], map: "idx_user_groups_group_id")
}

model UserPermission {
  id           Int        @id @default(autoincrement()) @map("id")
  userId       Int        @map("user_id")
  permissionId Int        @map("permission_id")

  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@map("user_permissions")
  @@index([userId], map: "idx_user_permissions_user_id")
  @@index([permissionId], map: "idx_user_permissions_permission_id")
}

model SessionStore {
  sessionKey  String   @id @map("session_key")
  sessionData String?  @map("session_data")
  expireDate  DateTime @map("expire_date")

  @@map("session_store")
}